rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (matches auth.uid)
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - role: string (required, 'admin', 'manager', 'viewer')
    //   - createdAt: string (required)
    //
    // Collection: documents
    // Document ID: auto-generated
    // Fields:
    //   - code: string (required)
    //   - systemCode: string (required)
    //   - system: string (required)
    //   - documentType: string (required)
    //   - title: string (required)
    //   - version: string (required)
    //   - issueDate: string (required)
    //   - updateDate: string (required)
    //   - fileUrl: string (optional)
    //   - authorName: string (required)
    //   - status: string (required, 'draft', 'active', 'archived')
    //   - authorId: string (required)
    //   - createdAt: string (required)
    //   - updatedAt: string (required)
    //
    // Collection: devices
    // Document ID: auto-generated
    // Fields:
    //   - code: string (required)
    //   - name: string (required)
    //   - specs: string (optional)
    //   - status: string (required, 'active', 'maintenance', 'inactive')
    //   - location: string (required)
    //   - authorId: string (required)
    //   - createdAt: string (required)
    //   - updatedAt: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerForUpdate() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isOwnerForCreate() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' || 
        (request.auth.token.email == "diennuoc.aht@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isManager() {
      return isAuthenticated() && (getUserRole() == 'manager' || isAdmin());
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             (!('displayName' in data) || data.displayName is string) &&
             data.role in ['admin', 'manager', 'viewer'] &&
             data.createdAt is string;
    }

    function isValidDocument(data) {
      return hasOnlyAllowedFields(['code', 'systemCode', 'system', 'documentType', 'title', 'version', 'issueDate', 'updateDate', 'fileUrl', 'authorName', 'status', 'authorId', 'createdAt', 'updatedAt', 'history', 'updatedBy']) &&
             data.code is string && data.code.size() > 0 && data.code.size() < 100 &&
             data.systemCode is string && data.systemCode.size() >= 0 && data.systemCode.size() < 100 &&
             data.system is string && data.system.size() >= 0 && data.system.size() < 100 &&
             data.documentType is string && data.documentType.size() >= 0 && data.documentType.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 300 &&
             data.version is string && data.version.size() >= 0 && data.version.size() < 50 &&
             data.issueDate is string && data.issueDate.size() >= 0 && data.issueDate.size() < 50 &&
             data.updateDate is string && data.updateDate.size() >= 0 && data.updateDate.size() < 50 &&
             data.authorName is string && data.authorName.size() >= 0 && data.authorName.size() < 100 &&
             data.status in ['draft', 'active', 'archived'] &&
             (!('fileUrl' in data) || (data.fileUrl is string && data.fileUrl.size() < 1000)) &&
             (!('history' in data) || data.history is list) &&
             (!('updatedBy' in data) || data.updatedBy is string) &&
             data.authorId is string &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    function isValidDevice(data) {
      return hasOnlyAllowedFields(['code', 'name', 'specs', 'status', 'location', 'authorId', 'createdAt', 'updatedAt', 'type', 'origin', 'manager', 'contactInfo', 'measuringElement', 'protectionElement', 'poweredFrom', 'powersTo', 'installationDate', 'usageDate', 'subComponents', 'historyLogs', 'changeLogs']) &&
             data.code is string && data.code.size() > 0 && data.code.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 300 &&
             (!('specs' in data) || (data.specs is string && data.specs.size() < 5000)) &&
             data.status in ['active', 'maintenance', 'inactive'] &&
             data.location is string && data.location.size() >= 0 && data.location.size() < 500 &&
             (!('type' in data) || data.type is string) &&
             (!('origin' in data) || data.origin is string) &&
             (!('manager' in data) || data.manager is string) &&
             (!('contactInfo' in data) || data.contactInfo is string) &&
             (!('measuringElement' in data) || data.measuringElement is string) &&
             (!('protectionElement' in data) || data.protectionElement is string) &&
             (!('poweredFrom' in data) || data.poweredFrom is string) &&
             (!('powersTo' in data) || data.powersTo is string) &&
             (!('installationDate' in data) || data.installationDate is string) &&
             (!('usageDate' in data) || data.usageDate is string) &&
             (!('subComponents' in data) || data.subComponents is list) &&
             (!('historyLogs' in data) || data.historyLogs is list) &&
             (!('changeLogs' in data) || data.changeLogs is list) &&
             data.authorId is string &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Users can create their own profile with 'viewer' role, or admin can create any role
      allow create: if isAuthenticated() && 
                    isValidUser(request.resource.data) && 
                    hasRequiredFields(['uid', 'email', 'role', 'createdAt']) &&
                    (
                      (isOwnerForCreate() && request.resource.data.role == 'viewer') || 
                      (isOwnerForCreate() && exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && request.resource.data.role == get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role) ||
                      isAdmin()
                    );

      // Users can update their own profile (but not role), admin can update anything
      allow update: if isAuthenticated() && 
                    isValidUser(request.resource.data) && 
                    (
                      (isOwnerForUpdate() && request.resource.data.role == resource.data.role && uidNotModified()) || 
                      isAdmin()
                    );
                    
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.token.email == userId);
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      
      allow create: if isManager() && 
                    isValidDocument(request.resource.data) &&
                    hasRequiredFields(['code', 'systemCode', 'system', 'documentType', 'title', 'version', 'issueDate', 'updateDate', 'authorName', 'status', 'authorId', 'createdAt', 'updatedAt']) &&
                    request.resource.data.authorId == request.auth.uid;
                    
      allow update: if isManager() && 
                    isValidDocument(request.resource.data) &&
                    request.resource.data.authorId == resource.data.authorId &&
                    request.resource.data.createdAt == resource.data.createdAt;
                    
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      
      allow create: if isManager() && 
                    isValidDevice(request.resource.data) &&
                    hasRequiredFields(['code', 'name', 'status', 'location', 'authorId', 'createdAt', 'updatedAt']) &&
                    request.resource.data.authorId == request.auth.uid;
                    
      allow update: if isManager() && 
                    isValidDevice(request.resource.data) &&
                    request.resource.data.authorId == resource.data.authorId &&
                    request.resource.data.createdAt == resource.data.createdAt;
                    
      allow delete: if isAdmin();
    }

    match /inventory_items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager();
    }

    match /inventory_slips/{slipId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager();
    }

    match /inventory_requisitions/{requisitionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager();
    }

    match /inventory_subsystems/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager();
    }

    match /inventory_requisition_types/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager();
    }

    match /inventory_cost_codes/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isManager();
    }
  }
}
